{
  "name": "trackinggamesdiscordbot",
  "version": "0.1.0",
  "description": "Discord bot para seguimiento de logros y trofeos en Steam y PlayStation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "@prisma/client": "^5.10.2",
    "axios": "^1.6.8",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.8.1",
    "discord.js": "^14.15.2",
    "dotenv-flow": "^4.0.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "p-retry": "^6.2.0",
    "prom-client": "^15.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "nock": "^14.0.0",
    "prettier": "^3.2.5",
    "prisma": "^5.10.2",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1"
  }
}
