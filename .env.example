# Discord bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key

# Steam API
STEAM_API_KEY=your_steam_web_api_key

# PlayStation Network OAuth
PSN_CLIENT_ID=your_psn_client_id
PSN_CLIENT_SECRET=your_psn_client_secret
PSN_REDIRECT_URI=https://your.domain.com/oauth/psn/callback

# Database & cache
DATABASE_URL=postgresql://user:password@localhost:5432/tracking_bot
REDIS_URL=redis://localhost:6379

# Crypto
TOKEN_ENCRYPTION_KEY=32_character_minimum_secret_key_here

# Metrics
METRICS_PORT=9090
